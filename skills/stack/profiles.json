      "protectedPaths": [
        "{dir}/app/api/schema.d.ts",
        "{dir}/src/api/schema.d.ts",
        "{dir}/.nuxt/**",
        "{dir}/.output/**",
        "{dir}/.next/**"
      ],
      "formatOnEdit": {
        "glob": "{dir}/**/*.{ts,tsx,vue,js,mjs}",
        "cmd": "cd {dir} && pnpm exec eslint --fix {file}"
