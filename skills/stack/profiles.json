    "go-api": {
      "title": "Go API — contract-first OpenAPI (oapi-codegen strict server), chi, sqlc + pgx, goose, Postgres in Docker",
      "defaultDir": "api",
      "reference": "web-bff-go.md",
      "verify": {
        "any": [
          {
            "name": "api-generate",
            "cmd": "cd {dir} && go generate ./... && git diff --exit-code -- ."
          },
          {
            "name": "api-vet",
            "cmd": "cd {dir} && go vet ./..."
          },
          {
            "name": "api-lint",
            "cmd": "cd {dir} && golangci-lint run"
          },
          {
            "name": "api-test",
            "cmd": "cd {dir} && go test -race ./..."
          }
        ]
      },
      "protectedPaths": [
        "{dir}/internal/api/gen/**",
        "{dir}/internal/db/sqlc/**"
      ],
      "formatOnEdit": {
        "glob": "{dir}/**/*.go",
        "cmd": "gofmt -w {file}"
      },
      "prodPatterns": [
        "\\bgoose\\b.*\\b(up|down|reset)\\b.*(prod|PROD)",
        "\\bdocker\\s+(push|buildx\\s+.*--push)\\b.*:(latest|prod|v?\\d+\\.\\d+)",
        "\\bpsql\\b.*(prod|PROD)"
      ]
    },
    "flutter": {
      "title": "Flutter — Riverpod, go_router, Dio + generated OpenAPI client, freezed",
      "defaultDir": "mobile",
      "reference": "mobile-flutter.md",
      "verify": {
        "any": [
          {
            "name": "mobile-generate",
            "cmd": "cd {dir} && dart run build_runner build --delete-conflicting-outputs && git diff --exit-code -- ."
          },
          {
            "name": "mobile-analyze",
            "cmd": "cd {dir} && flutter analyze"
          },
          {
            "name": "mobile-test",
            "cmd": "cd {dir} && flutter test"
          }
        ]
      },
      "protectedPaths": [
        "**/*.g.dart",
        "**/*.freezed.dart",
        "{dir}/lib/api/gen/**"
      ],
      "formatOnEdit": {
        "glob": "{dir}/**/*.dart",
        "cmd": "dart format {file}"
      },
      "prodPatterns": [
        "\\bfastlane\\b.*\\b(release|deploy|supply|deliver|pilot|upload)",
        "\\bflutterfire\\b.*\\bdeploy\\b",
        "\\bfirebase\\s+deploy\\b"
      ]
    },
