{
  "$comment": "Component presets merged into .sdlc/config.json by `sdlc stack`. {dir} is the component folder; '.' when the repo holds a single component.",
  "components": {
    "edge-web": {
      "title": "Nuxt 4 (or Next) full-stack on Cloudflare Workers — D1 + KV + R2, SPA mode",
      "defaultDir": "web",
      "reference": "web-edge.md",
      "verify": {
        "vue": [
          {
            "name": "typecheck",
            "cmd": "cd {dir} && pnpm run typecheck"
          },
          {
            "name": "lint",
            "cmd": "cd {dir} && pnpm run lint"
          },
          {
            "name": "test",
            "cmd": "cd {dir} && pnpm run test"
          },
          {
            "name": "build",
            "cmd": "cd {dir} && pnpm run build"
          }
        ],
        "react": [
          {
            "name": "typecheck",
            "cmd": "cd {dir} && pnpm exec tsc --noEmit"
          },
          {
            "name": "lint",
            "cmd": "cd {dir} && pnpm run lint"
          },
          {
            "name": "test",
            "cmd": "cd {dir} && pnpm run test"
          },
          {
            "name": "build",
            "cmd": "cd {dir} && pnpm exec opennextjs-cloudflare build"
          }
        ]
      },
      "protectedPaths": [
        "{dir}/server/db/migrations/**",
        "{dir}/worker-configuration.d.ts",
        "{dir}/.nuxt/**",
        "{dir}/.output/**",
        "{dir}/.open-next/**"
      ],
      "formatOnEdit": {
        "glob": "{dir}/**/*.{ts,tsx,vue,js,mjs}",
        "cmd": "cd {dir} && pnpm exec eslint --fix {file}"
      },
      "prodPatterns": [
        "\\bwrangler\\s+d1\\s+(migrations\\s+apply|execute)\\b.*--remote",
        "\\bwrangler\\s+(kv|r2)\\b.*\\b(delete|put)\\b(?!.*--local)",
        "\\bwrangler\\s+secret\\s+put\\b"
      ]
    },
