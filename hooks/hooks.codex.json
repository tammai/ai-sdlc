{
  "description": "ai-sdlc guardrails for Codex. Review and trust these hooks before relying on them.",
  "hooks": {
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "node \"${PLUGIN_ROOT}/scripts/codex-hook.mjs\" SessionStart", "timeout": 10 }] }
    ],
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "node \"${PLUGIN_ROOT}/scripts/codex-hook.mjs\" UserPromptSubmit", "timeout": 10 }] }
    ],
    "PreToolUse": [
      { "matcher": "^(Bash|apply_patch)$", "hooks": [{ "type": "command", "command": "node \"${PLUGIN_ROOT}/scripts/codex-hook.mjs\" PreToolUse", "timeout": 10 }] }
    ],
    "PostToolUse": [
      { "matcher": "^apply_patch$", "hooks": [{ "type": "command", "command": "node \"${PLUGIN_ROOT}/scripts/codex-hook.mjs\" PostToolUse", "timeout": 30 }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "node \"${PLUGIN_ROOT}/scripts/codex-hook.mjs\" Stop", "timeout": 10 }] }
    ]
  }
}
