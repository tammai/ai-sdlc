# Copy to .dev.vars for local secrets (never commit .dev.vars; `next dev` and `wrangler dev` read it).
# Production/staging: `wrangler secret put <NAME>` (a human step — secrets are gated).
# Better Auth, when you add it:
BETTER_AUTH_SECRET=change-me-to-a-random-string-of-32-chars-or-more
BETTER_AUTH_URL=http://localhost:3000
